# Conexión a la base de datos local
spring.datasource.url=jdbc:postgresql:Sin//base_de_datos//
spring.datasource.username=postgres
spring.datasource.password=Sin//Contrasena//

# Magia de Spring: Crea y actualiza las tablas automáticamente basándose en su código Java
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.open-in-view=false

# ==========================================
# CONFIGURACIÓN DE CORREO (JavaMailSender)
# ==========================================
spring.mail.host=credenciales
spring.mail.port=puertoAbierto
spring.mail.username=UserCorreo
spring.mail.password=dieciseisCaracteres
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true